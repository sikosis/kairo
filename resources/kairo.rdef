resource app_signature "application/x-vnd.Kairo-Agent";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
    major = @KAIRO_VERSION_MAJOR@,
    middle = @KAIRO_VERSION_MINOR@,
    minor = 0,
    variety = B_APPV_FINAL,
    internal = @KAIRO_VERSION_MINOR@,
    short_info = "Kairo @KAIRO_VERSION@",
    long_info = "Native AI pair programming for Haiku"
};
